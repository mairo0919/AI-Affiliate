# AI Affiliate Factory

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose)
POSTGRES_DB=ai_affiliate
POSTGRES_USER=ai_affiliate
POSTGRES_PASSWORD=ai_affiliate_dev
POSTGRES_PORT=5432

# Prisma / app connection string
DATABASE_URL=postgresql://ai_affiliate:ai_affiliate_dev@localhost:5432/ai_affiliate?schema=public

# DMM Web API (FANZA Provider)
# Register at https://affiliate.dmm.com/api/
# Site approval is required before API registration.
# Affiliate ID for API must end with 990-999.
DMM_API_ID=
DMM_AFFILIATE_ID=
DMM_API_BASE_URL=https://api.dmm.com/affiliate/v3
# Set true only while DMM API approval is still pending (scheduler skips FANZA only).
DMM_API_APPROVAL_PENDING=false
FANZA_DEFAULT_SERVICE=digital
FANZA_DEFAULT_FLOOR=videoa
FANZA_DEFAULT_HITS=100
FANZA_REQUEST_INTERVAL_MS=1000
FANZA_REQUEST_TIMEOUT_MS=15000
FANZA_MAX_RETRIES=3
# X listing site approval on DMM/FANZA affiliate console (e.g. @osusume_media).
# Keep false until you confirm approval. Do not invent true.
FANZA_X_SITE_APPROVED=false

# Multi-ASP Research auto-collection (system schedules ensured by scheduler)
# After DMM credentials are set, FANZA collection runs without further code changes.
RESEARCH_COLLECTION_ENABLED=true
RESEARCH_ENABLED_PROVIDERS=fanza
RESEARCH_COLLECTION_CRON=0 */6 * * *
RESEARCH_COLLECTION_TIMEZONE=Asia/Tokyo
RESEARCH_FANZA_MAX_PAGES=1
RESEARCH_FANZA_MAX_ITEMS=100
RESEARCH_FANZA_SORT=date

# Research schedules
RESEARCH_SCHEDULE_FAILURE_LIMIT=5
RESEARCH_SCHEDULE_GRACE_MS=900000

# Automatic retry
RESEARCH_RETRY_ENABLED=true
RESEARCH_RETRY_MAX_ATTEMPTS=3
RESEARCH_RETRY_BASE_DELAY_SECONDS=300
RESEARCH_RETRY_MAX_DELAY_SECONDS=3600

# Notifications (console locally; webhook URL via env/secret only — never commit real URLs)
RESEARCH_NOTIFICATION_ENABLED=true
RESEARCH_NOTIFICATION_CHANNEL=console
RESEARCH_NOTIFICATION_WEBHOOK_URL=
RESEARCH_NOTIFICATION_TIMEOUT_MS=10000
RESEARCH_NOTIFICATION_MAX_ATTEMPTS=3

# Analysis Engine (auto-run disabled by default)
# After Research collection works, set true so scheduler runs Analysis → ContentCandidate.
ANALYSIS_AUTO_RUN_ENABLED=false
ANALYSIS_AUTO_RUN_SOURCE=fanza
ANALYSIS_AUTO_RUN_LIMIT=1000
ANALYSIS_AUTO_RUN_MIN_INTERVAL_MINUTES=60

# Content Engine (Mock by default — no real AI API required)
CONTENT_GENERATION_PROVIDER=mock
CONTENT_GENERATION_MODEL=mock-v1
CONTENT_GENERATION_TIMEOUT_MS=30000
CONTENT_GENERATION_MAX_ATTEMPTS=2
CONTENT_DEFAULT_REVIEWER=admin
CONTENT_X_MAX_LENGTH=140
CONTENT_BLOG_MIN_LENGTH=800
CONTENT_BLOG_MAX_LENGTH=1500
CONTENT_VIDEO_MIN_SECONDS=15
CONTENT_VIDEO_MAX_SECONDS=45
CONTENT_FORBIDDEN_TEXT_SIMILARITY_THRESHOLD=0.8
CONTENT_DUPLICATE_SIMILARITY_THRESHOLD=0.9
CONTENT_DUPLICATE_SIMILARITY_SEVERITY=WARNING
CONTENT_AUTO_GENERATION_ENABLED=false
CONTENT_AUTO_GENERATION_LIMIT=20
CONTENT_AUTO_GENERATION_TYPES=x-post
CONTENT_AUTO_GENERATION_MIN_SCORE=70
CONTENT_AUTO_GENERATION_INCLUDE_REQUIRES_CONFIRMATION=false
CONTENT_AUTO_GENERATION_MIN_INTERVAL_MINUTES=60
CONTENT_NOTIFY_REVIEW_REQUIRED=false
CONTENT_NOTIFY_APPROVED=false
CONTENT_NOTIFY_REJECTED=false

# X Publishing & Learning Engine (Mock by default — no real X API required)
X_API_ENABLED=false
X_API_PROVIDER=mock
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
X_API_ACCESS_TOKEN=
X_API_REFRESH_TOKEN=
X_API_ACCOUNT_ID=
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT_MS=30000
X_API_MAX_ATTEMPTS=3
X_API_USER_AGENT=AI-Affiliate-Factory/1.0
X_TOKEN_ENCRYPTION_KEY=
X_TOKEN_ENCRYPTION_KEY_VERSION=v1
X_OAUTH_AUTHORIZE_URL=https://twitter.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token
X_OAUTH_REVOKE_URL=https://api.x.com/2/oauth2/revoke
X_OAUTH_CALLBACK_URL=http://127.0.0.1:8787/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access
X_OAUTH_SESSION_TTL_MINUTES=15
X_TOKEN_REFRESH_BUFFER_MINUTES=10
X_VERIFY_PUBLISHED_POST_ENABLED=true
X_VERIFY_PUBLISHED_POST_DELAY_SECONDS=5
X_DELETE_POST_ENABLED=false
X_API_WRITE_COST_PER_REQUEST=
X_API_READ_COST_PER_RESOURCE=
X_API_ANALYTICS_COST_PER_REQUEST=
X_API_COST_CURRENCY=USD
X_API_DAILY_SOFT_BUDGET_USD=1
X_API_DAILY_HARD_BUDGET_USD=3
X_API_MONTHLY_SOFT_BUDGET_USD=10
X_API_MONTHLY_HARD_BUDGET_USD=30
X_API_UNKNOWN_COST_BEHAVIOR=BLOCK
X_API_USAGE_SYNC_ENABLED=false
X_API_USAGE_SYNC_MIN_INTERVAL_MINUTES=1440
X_NOTIFY_TOKEN_REFRESH_FAILED=true
X_NOTIFY_CREDENTIAL_REAUTH_REQUIRED=true
X_NOTIFY_ACCOUNT_MISMATCH=true
X_NOTIFY_HARD_BUDGET_REACHED=true
X_NOTIFY_POST_PUBLISHED_UNVERIFIED=true
X_NOTIFY_LIVE_POST_PUBLISHED=true
X_MAX_WEIGHTED_LENGTH=280
X_TARGET_WEIGHTED_LENGTH=250
X_RESERVED_WEIGHTED_LENGTH=20
X_MAX_HASHTAGS=2
X_MAX_POSTS_PER_PUBLICATION=3
X_AUTO_MAX_POSTS_PER_PUBLICATION=2
X_AFFILIATE_DISCLOSURE=#PR
X_URL_WEIGHTED_LENGTH=23
X_STRATEGY_SELECTION_MODE=round-robin
X_STRATEGY_EXPLORATION_RATE=0.2
X_STRATEGY_MIN_SAMPLE_SIZE=30
X_STRATEGY_EVALUATION_WINDOW_HOURS=72
X_STRATEGY_AUTO_OPTIMIZATION_ENABLED=false
X_STRATEGY_AUTO_ENABLED_TYPES=single-post,root-with-reply,related-post-link,control
X_AUTO_PUBLICATION_ENABLED=false
X_METRICS_COLLECTION_ENABLED=false
X_METRICS_COLLECTION_WINDOWS_MINUTES=60,360,1440,4320,10080
X_METRICS_COLLECTION_BATCH_SIZE=100
X_STRATEGY_EVALUATION_ENABLED=false
X_NOTIFY_PUBLICATION_PUBLISHED=false
X_NOTIFY_STRATEGY_EVALUATION_COMPLETED=false
X_RELATED_LOOKBACK_DAYS=30
X_OPTIMIZATION_ENABLED=false
X_OPTIMIZATION_MODE=RECOMMEND
X_OPTIMIZATION_MIN_INTERVAL_MINUTES=1440
X_OPTIMIZATION_MIN_SAMPLE_SIZE=30
X_OPTIMIZATION_MIN_SCORE_IMPROVEMENT=0.05
X_OPTIMIZATION_MAX_MISSING_RATE=0.4
X_OPTIMIZATION_LOOKBACK_DAYS=90
X_OPTIMIZATION_EVALUATION_WINDOW_HOURS=72
X_OPTIMIZATION_EXPLORATION_RATE=0.2
X_OPTIMIZATION_RECOMMENDATION_TTL_DAYS=30
X_OPTIMIZATION_MAX_ACTIVE_RECOMMENDATIONS=10
X_OPTIMIZATION_MAX_CONCURRENT_EXPERIMENTS_PER_DIMENSION=1
X_OPTIMIZATION_DECLINE_STOP_THRESHOLD=-0.10
X_OPTIMIZATION_DEFAULT_REVIEWER=admin
X_OPTIMIZATION_IMPACT_EVALUATION_ENABLED=false
X_NOTIFY_OPTIMIZATION_RECOMMENDATION_CREATED=true
X_NOTIFY_OPTIMIZATION_DECLINED=true
X_NOTIFY_OPTIMIZATION_VALIDATION_FAILED=true
X_DENSITY_LOW_MAX_WEIGHTED_LENGTH=120
X_DENSITY_MEDIUM_MAX_WEIGHTED_LENGTH=220
X_DENSITY_LOW_MAX_FACT_COUNT=1
X_DENSITY_MEDIUM_MAX_FACT_COUNT=4
X_DENSITY_LOW_MAX_ENTITY_COUNT=2
X_DENSITY_MEDIUM_MAX_ENTITY_COUNT=5
X_DENSITY_LOW_MAX_URL_COUNT=0
X_DENSITY_MEDIUM_MAX_URL_COUNT=1
X_DENSITY_LOW_MAX_HASHTAG_COUNT=1
X_DENSITY_MEDIUM_MAX_HASHTAG_COUNT=2
X_PRODUCT_COOLDOWN_HOURS=168
X_PRODUCT_RESERVATION_TTL_MINUTES=30
X_ALLOW_DUPLICATE_PRODUCT_EXPERIMENTS=false
X_DUPLICATE_PRODUCT_MIN_INTERVAL_HOURS=72
X_RELEASE_MODE=DISABLED
X_RELEASE_ALLOWED_ACCOUNT_IDS=
X_RELEASE_ALLOWED_STRATEGIES=CONTROL,SINGLE_POST
X_RELEASE_ALLOWED_CANDIDATE_TYPES=
X_RELEASE_DAILY_POST_LIMIT=3
X_RELEASE_HOURLY_POST_LIMIT=1
X_RELEASE_ALLOWED_START_HOUR_JST=9
X_RELEASE_ALLOWED_END_HOUR_JST=23
X_GLOBAL_KILL_SWITCH=true
X_POST_BODY_DUPLICATE_LOOKBACK_DAYS=30
X_POST_BODY_NEAR_DUPLICATE_THRESHOLD=0.92
X_NOTIFY_PUBLICATION_BLOCKED=true
X_NOTIFY_PRODUCT_COOLDOWN_BLOCKED=true
X_NOTIFY_PUBLICATION_LIMIT_REACHED=false
X_NOTIFY_KILL_SWITCH_ENABLED=true
X_NOTIFY_DUPLICATE_CONTENT_BLOCKED=true
# Recommended before real X API:
# X_GLOBAL_KILL_SWITCH=true
# X_RELEASE_MODE=DISABLED
# X_AUTO_PUBLICATION_ENABLED=false
# X_METRICS_COLLECTION_ENABLED=false
# X_OPTIMIZATION_ENABLED=false
# Note: X API usage may incur costs. Keep X_API_ENABLED=false until credentials and budget are ready.

# Link / CTA priority (Publication Planner + Link Resolver)
# Normal-link order: preferred provider product → future ASP → official → trusted → none
# Default preferred provider is DMM/FANZA (`fanza`). Overridable.
PREFERRED_AFFILIATE_PROVIDER=fanza
# Optional comma-separated future ASP keys (priority band 2 + affiliateReplacementCandidate)
LINK_FUTURE_ASP_PROVIDERS=

# Publication queue (soft targets — quality overrides volume)
PUBLICATION_TARGET_PER_DAY=2
PUBLICATION_MAXIMUM_PER_DAY=3
PUBLICATION_MINIMUM_INTERVAL_MINUTES=180
PUBLICATION_PAUSE_WHEN_NO_QUALIFIED=true

# LLM (P4.5) — default mock; production requires LLM_MODE=api + LLM_ALLOW_EXTERNAL_REQUESTS=true
LLM_MODE=mock
LLM_PROVIDER=openai-compatible
LLM_MODEL_GENERATION=gpt-4.1-mini
LLM_MODEL_REVIEW=gpt-4.1-mini
LLM_MODEL_REVISION=gpt-4.1-mini
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=2
LLM_ALLOW_EXTERNAL_REQUESTS=false
LLM_CURRENCY=JPY
LLM_ESTIMATED_YEN_PER_1K_INPUT_TOKENS=0.15
LLM_ESTIMATED_YEN_PER_1K_OUTPUT_TOKENS=0.6

# Blogger (P4.5) — default mock draft; never direct-publish by default
BLOGGER_MODE=mock
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=
BLOGGER_DEFAULT_PUBLISH_MODE=draft
BLOGGER_ALLOW_DIRECT_PUBLISH=false
BLOGGER_ALLOW_EXTERNAL_REQUESTS=false
BLOGGER_API_BASE_URL=https://www.googleapis.com/blogger/v3
BLOGGER_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
BLOGGER_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
BLOGGER_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/blogger/callback
BLOGGER_OAUTH_SCOPES=https://www.googleapis.com/auth/blogger

# WordPress REST (Application Password). Defaults stay mock / off until live confirm.
# Production site BASE URL (current): https://otonaselect.net
# Legacy host otonaselect.mixh.jp is retired for operational config — keep only in historical publication records.
WORDPRESS_MODE=mock
WORDPRESS_BASE_URL=https://otonaselect.net
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_DEFAULT_PUBLISH_MODE=draft
WORDPRESS_ALLOW_DIRECT_PUBLISH=false
# Future reservation (status=future) without enabling unrestricted live publish
WORDPRESS_ALLOW_FUTURE_SCHEDULE=false
WORDPRESS_ALLOW_EXTERNAL_REQUESTS=false
WORDPRESS_API_NAMESPACE=wp/v2
# Contact form notify address (stored as WP option via deploy/CLI — never hardcode in theme PHP)
WORDPRESS_CONTACT_NOTIFY_EMAIL=
# Optional GA4 Measurement ID (also settable in WP Admin → アクセス概要)
# OTONASELECT_GA4_MEASUREMENT_ID=G-XXXXXXXX

# Continuous APPROVED stock + JST publish slots (separate from generation rate)
# 9 / 101 are NOT hard caps. Research soft target is guidance only.
STOCK_GENERATION_ENABLED=true
STOCK_PUBLISH_SCHEDULER_ENABLED=true
STOCK_MIN_APPROVED=0
STOCK_GENERATION_BATCH=3
STOCK_GENERATION_BATCH_SIZE=3
STOCK_MAX_GENERATIONS_PER_DAY=48
WP_PUBLISH_SLOTS_JST=12,21,23
WORDPRESS_SCHEDULE_HORIZON_DAYS=90
WORDPRESS_SCHEDULE_MAX_PER_TICK=15
WORDPRESS_PROTECTED_POST_IDS=43,46
RESEARCH_SOFT_TARGET=500
# Mac/ops only — Railway uses provider ItemList schedules
STOCK_LOCAL_PAGE_RESEARCH_IN_SCHEDULER=false
# Set true only after completing FANZA_AFFILIATE_IMAGE_TERMS_CHECKLIST (ops confirm CLI)
FANZA_AFFILIATE_IMAGE_TERMS_VERIFIED=false
LOCAL_PAGE_RESEARCH_INTERVAL_MS=2500
LOCAL_PAGE_RESEARCH_MAX_PER_RUN=20

# P7 Admin API / Operations Console (internal only — never expose publicly without auth)
ADMIN_API_PORT=8788
ADMIN_API_HOST=127.0.0.1
ADMIN_SESSION_TTL_HOURS=12
ADMIN_CORS_ORIGIN=http://localhost:3001
# Bootstrap admin (seed hashes password — plaintext is never stored)
ADMIN_BOOTSTRAP_EMAIL=admin@localhost
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin
ADMIN_ALLOW_DIRECT_PUBLISH_UI=false
ADMIN_RATE_LIMIT_PER_MINUTE=120
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_FORCE_MOCK_ADAPTERS=false

# P8 production operation
# OBSERVE | ASSISTED | AUTOMATED — initial ops use ASSISTED
PRODUCTION_OPERATION_MODE=ASSISTED
PUBLICATION_ACTIVE_HOURS_START=9
PUBLICATION_ACTIVE_HOURS_END=22
PUBLICATION_TIMEZONE=Asia/Tokyo
PUBLICATION_MINIMUM_QUALITY_SCORE=0.55
PUBLICATION_MINIMUM_CLAIM_CONFIDENCE=0.5
LLM_MODEL_STRATEGY=gpt-4.1-mini
LLM_TEMPERATURE=0.4
LLM_DAILY_TOKEN_BUDGET=

# P9 research fetch (public URL). Requires --confirm-external on CLI as well.
RESEARCH_ALLOW_EXTERNAL_REQUESTS=false
RESEARCH_FETCH_TIMEOUT_MS=15000
RESEARCH_FETCH_MAX_BYTES=512000

# R54 Daily FANZA blog auto-publish (default OFF / dry-run)
# Cron is consumed by ResearchSchedule — never hardcode clock in application code.
BLOG_DAILY_AUTO_PUBLISH_ENABLED=false
BLOG_DAILY_DRY_RUN=true
BLOG_DAILY_TIMEZONE=Asia/Tokyo
BLOG_DAILY_CRON=0 10 * * *
BLOG_DAILY_ARTICLES_PER_RUN=1
BLOG_DAILY_MAX_LLM_PRODUCTS=1
BLOG_DAILY_MAX_LLM_CALLS=1
BLOG_DAILY_MAX_CANDIDATES_SCAN=30
BLOG_DAILY_MIN_TOTAL_SCORE=35
BLOG_DAILY_MIN_SAMPLE_IMAGES=3
BLOG_DAILY_MIN_EVIDENCE_RICHNESS=0.3
BLOG_DAILY_INJECT_ARTICLE_JSONLD=false
BLOG_DAILY_RANKING_ENABLED=false
BLOG_DAILY_RANKING_EVERY_N_PRODUCTS=7
BLOG_DAILY_RANKING_MIN_DAYS=7
BLOG_DAILY_RANKING_TYPES=POPULAR,NEW_RELEASE

# Multi-channel daily targets (Blog + X). Counts live here — avoid scattering magic numbers.
DAILY_OPS_ENABLED=false
DAILY_OPS_DRY_RUN=true
DAILY_OPS_TIMEZONE=Asia/Tokyo
DAILY_BLOG_ARTICLES=1
DAILY_X_POSTS=1
DAILY_MIX_WEIGHT_RECENT=0.3
DAILY_MIX_WEIGHT_MID=0.3
DAILY_MIX_WEIGHT_OLDER=0.3
DAILY_MIX_WEIGHT_RANKING=0.1
DAILY_AGE_RECENT_MAX_DAYS=60
DAILY_AGE_OLDER_MIN_DAYS=365
DAILY_CHANNEL_PRODUCT_COOLDOWN_DAYS=14
DAILY_X_BODY_COOLDOWN_DAYS=7
DAILY_RANKING_ENABLED=false
DAILY_RANKING_MODE=REPLACE_BLOG_ARTICLE
DAILY_RANKING_EVERY_N_BLOG_ARTICLES=7
DAILY_RANKING_MIN_DAYS=7
