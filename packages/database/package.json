{
  "name": "@ai-affiliate/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/prisma.mjs generate && tsc -p tsconfig.json",
    "generate": "node ./scripts/prisma.mjs generate",
    "migrate": "node ./scripts/prisma.mjs migrate deploy",
    "migrate:dev": "node ./scripts/prisma.mjs migrate dev",
    "seed": "node ./scripts/prisma.mjs db seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-affiliate/shared": "workspace:*",
    "@prisma/client": "^6.13.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "^6.13.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
