  GENERATING
  REVIEWING
  REVISION_REQUIRED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  PAUSED
  REJECTED
  ARCHIVED
}

enum ContentVersionStatus {
  DRAFT
  REVIEWING
  REVISION_REQUIRED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ContentFormatCategory {
  ARTICLE
  SHORT_POST
