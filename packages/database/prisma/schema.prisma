  @@index([scope, channel, createdAt])
  @@index([formatKey, channel, createdAt])
  @@index([claimProfile, createdAt])
  @@index([structurePatternId, createdAt])
  @@index([editorialPatternId, createdAt])
  @@index([sourceType, createdAt])
  @@index([brainRunId])
  @@index([contentVersionId])
  @@index([confidence, createdAt])
}

/// Ephemeral upload reference — raw file body is NOT stored by default
model FileUploadReference {
  id           String   @id @default(cuid())
  purpose      String
  fileName     String?
  contentType  String?
  byteLength   Int?
  fileHash     String
  retention    String   @default("ephemeral")
  previewMeta  Json?
  createdBy    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime?

  @@index([fileHash, purpose])
  @@index([createdAt])
}

