generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  FANZA
  TIKTOK
  X
  OTHER
}

enum ImageUsageStatus {
  ALLOWED
  REQUIRES_CONFIRMATION
  NOT_ALLOWED
  UNKNOWN
}

model ResearchSource {
  id        String     @id @default(cuid())
  name      String     @unique
  type      SourceType
  baseUrl   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     ResearchItem[]
}

model ResearchItem {
  id          String   @id @default(cuid())
  sourceId    String
  externalId  String
  itemType    String
  title       String
  description String?
  url         String?
  publishedAt DateTime?
  collectedAt DateTime
  rawData     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source            ResearchSource     @relation(fields: [sourceId], references: [id])
  metrics           ResearchMetric[]
  tags              ResearchItemTag[]
  images            ResearchImage[]
  productAnalyses   ProductAnalysis[]
  contentCandidates ContentCandidate[]
  generatedContents GeneratedContent[]
  xPublications     XPublication[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([itemType, collectedAt])
}

model ResearchMetric {
  id             String   @id @default(cuid())
  researchItemId String
  metricType     String
  value          Float
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@index([researchItemId, recordedAt])
}

model ResearchTag {
  id        String   @id @default(cuid())
  name      String
  type      String
  createdAt DateTime @default(now())

  items ResearchItemTag[]

  @@unique([name, type])
}

model ResearchItemTag {
  researchItemId String
  researchTagId  String

  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  researchTag  ResearchTag  @relation(fields: [researchTagId], references: [id], onDelete: Cascade)

  @@id([researchItemId, researchTagId])
}

model ResearchImage {
  id             String           @id @default(cuid())
  researchItemId String
  imageType      String
  sourceUrl      String
  size           String?
  usageStatus    ImageUsageStatus @default(REQUIRES_CONFIRMATION)
  usageNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  researchItem ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  @@unique([researchItemId, imageType, sourceUrl])
  @@index([researchItemId])
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
  MANUAL_REVIEW_REQUIRED
}

enum ResearchJobType {
  SINGLE_PAGE
  PAGINATED_COLLECTION
  RESEARCH
  STRATEGY
  GENERATION
  CLAIM_VALIDATION
  REVIEW
  REVISION
  PUBLICATION
  ANALYTICS_INGESTION
  MAINTENANCE
  OPERATION_CYCLE
  LEARNING_GOVERNANCE
}

model ResearchJob {
  id               String            @id @default(cuid())
  providerName     String
  jobType          ResearchJobType
  status           ResearchJobStatus @default(PENDING)
  parameters       Json
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  lastHeartbeatAt  DateTime?
  currentOffset    Int?
  nextOffset       Int?
  fetchedCount     Int               @default(0)
  mappedCount      Int               @default(0)
  savedCount       Int               @default(0)
  updatedCount     Int               @default(0)
  skippedCount     Int               @default(0)
  errorCount       Int               @default(0)
  pagesProcessed   Int               @default(0)
  errorMessage     String?
  cancelRequested  Boolean           @default(false)
  resumedFromJobId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  errors        ResearchJobError[]
  lock          ResearchJobLock?
  scheduleRuns  ResearchScheduleRun[]
  notifications ResearchNotification[]

  @@index([providerName, status])
  @@index([createdAt])
}

model ResearchJobError {
  id           String   @id @default(cuid())
  jobId        String
  providerName String
  stage        String
  externalId   String?
  offset       Int?
  errorType    String
  message      String
  retryable    Boolean  @default(false)
  createdAt    DateTime @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ResearchJobLock {
  id         String   @id @default(cuid())
  lockKey    String   @unique
  jobId      String   @unique
  acquiredAt DateTime
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum ResearchScheduleType {
  CRON
  MANUAL_ONLY
}

enum ResearchScheduleTriggerType {
  SCHEDULED
  MANUAL
  RETRY
}

enum ResearchScheduleRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  SKIPPED
}

model ResearchSchedule {
  id                       String               @id @default(cuid())
  name                     String
  providerName             String
  scheduleType             ResearchScheduleType
  cronExpression           String?
  timezone                 String               @default("Asia/Tokyo")
  parameters               Json
  isActive                 Boolean              @default(true)
  lastRunAt                DateTime?
  nextRunAt                DateTime?
  lastJobId                String?
  consecutiveFailureCount  Int                  @default(0)
  deletedAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  runs          ResearchScheduleRun[]
  lock          ResearchScheduleLock?
  notifications ResearchNotification[]

  @@index([isActive, nextRunAt])
  @@index([deletedAt])
  @@index([providerName])
}

model ResearchScheduleRun {
  id               String                     @id @default(cuid())
  scheduleId       String
  jobId            String?
  triggerType      ResearchScheduleTriggerType
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  status           ResearchScheduleRunStatus  @default(PENDING)
  errorMessage     String?
  errorType        String?
  retryOfRunId     String?
  rootRunId        String?
  retryAttempt     Int                        @default(0)
  maxRetryAttempts Int?
  nextRetryAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  schedule      ResearchSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  job           ResearchJob?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  retryOfRun    ResearchScheduleRun?   @relation("ScheduleRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries       ResearchScheduleRun[]  @relation("ScheduleRunRetries")
  notifications ResearchNotification[]

  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, status])
  @@index([jobId])
  @@index([createdAt])
  @@index([nextRetryAt, status])
  @@index([rootRunId])
  @@index([retryOfRunId])
}

model ResearchScheduleLock {
  id          String   @id @default(cuid())
  scheduleId  String   @unique
  ownerToken  String
  acquiredAt  DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule ResearchSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum ResearchNotificationEventType {
  SCHEDULE_FAILED
  SCHEDULE_PARTIALLY_COMPLETED
  SCHEDULE_AUTO_PAUSED
  SCHEDULE_RECOVERED
  JOB_FAILED
  JOB_PARTIALLY_COMPLETED
  RETRY_SCHEDULED
  RETRY_EXHAUSTED
  CONTENT_GENERATION_FAILED
  CONTENT_VALIDATION_FAILED
  CONTENT_REVIEW_REQUIRED
  CONTENT_APPROVED
  CONTENT_REJECTED
  X_PUBLICATION_FAILED
  X_PUBLICATION_PARTIALLY_PUBLISHED
  X_PUBLICATION_PUBLISHED
  X_REPLY_FAILED
  X_METRICS_COLLECTION_FAILED
  X_STRATEGY_EVALUATION_COMPLETED
  X_OPTIMIZATION_RECOMMENDATION_CREATED
  X_OPTIMIZATION_RECOMMENDATION_APPROVED
  X_OPTIMIZATION_RECOMMENDATION_REJECTED
  X_OPTIMIZATION_EXPERIMENT_STARTED
  X_OPTIMIZATION_IMPROVED
  X_OPTIMIZATION_DECLINED
  X_OPTIMIZATION_VALIDATION_FAILED
  X_PUBLICATION_BLOCKED
  X_PRODUCT_COOLDOWN_BLOCKED
  X_PUBLICATION_LIMIT_REACHED
  X_KILL_SWITCH_ENABLED
  X_RELEASE_MODE_CHANGED
  X_ASSISTED_REVIEW_REQUIRED
  X_RESERVATION_EXPIRED
  X_DUPLICATE_CONTENT_BLOCKED
  X_AUTHORIZATION_COMPLETED
  X_AUTHORIZATION_FAILED
  X_TOKEN_REFRESH_FAILED
  X_CREDENTIAL_REAUTH_REQUIRED
  X_ACCOUNT_MISMATCH
  X_API_RATE_LIMITED
  X_API_SOFT_BUDGET_REACHED
  X_API_HARD_BUDGET_REACHED
  X_API_USAGE_SYNC_FAILED
  X_POST_PUBLISHED_UNVERIFIED
  X_LIVE_POST_PUBLISHED
}

enum ResearchNotificationChannelType {
  CONSOLE
  WEBHOOK
}

enum ResearchNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

model ResearchNotification {
  id               String                          @id @default(cuid())
  eventType        ResearchNotificationEventType
  providerName     String?
  scheduleId       String?
  scheduleRunId    String?
  researchJobId    String?
  channelType      ResearchNotificationChannelType
  status           ResearchNotificationStatus      @default(PENDING)
  deduplicationKey String                          @unique
  title            String
  message          String
  payload          Json
  attemptCount     Int                             @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  errorMessage     String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  schedule  ResearchSchedule?             @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleRun ResearchScheduleRun?        @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)
  job       ResearchJob?                  @relation(fields: [researchJobId], references: [id], onDelete: SetNull)
  attempts  ResearchNotificationAttempt[]

  @@index([status, createdAt])
  @@index([scheduleId])
  @@index([scheduleRunId])
  @@index([researchJobId])
  @@index([eventType])
}

model ResearchNotificationAttempt {
  id             String                     @id @default(cuid())
  notificationId String
  attemptNumber  Int
  status         ResearchNotificationStatus
  httpStatus     Int?
  errorType      String?
  errorMessage   String?
  startedAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime                   @default(now())

  notification ResearchNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, attemptNumber])
}

enum AnalysisType {
  PRODUCT_SCORING
  TREND_DETECTION
  CONTENT_CANDIDATE_SELECTION
}

enum AnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum EligibilityStatus {
  ELIGIBLE
  REQUIRES_CONFIRMATION
  NOT_ELIGIBLE
}

enum ContentCandidateType {
  RANKING
  TRENDING
  HIGH_RATING
  NEW_RELEASE
  DISCOUNT
  EDITORIAL
}

enum ContentTargetChannel {
  BLOG
  X
  SHORT_VIDEO
  GENERIC
}

enum ContentCandidateStatus {
  SELECTED
  HELD
  REJECTED
  CONTENT_CREATED
  PUBLISHED
}

model AnalysisRun {
  id                 String            @id @default(cuid())
  analysisType       AnalysisType
  status             AnalysisRunStatus @default(PENDING)
  parameters         Json
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  analyzedItemCount  Int               @default(0)
  selectedItemCount  Int               @default(0)
  errorCount         Int               @default(0)
  errorMessage       String?
  scoringVersion     String            @default("scoring-v1")
  eligibilityVersion String            @default("eligibility-v1")
  selectionVersion   String            @default("selection-v1")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  productAnalyses   ProductAnalysis[]
  contentCandidates ContentCandidate[]

  @@index([status, createdAt])
  @@index([analysisType, createdAt])
}

model ProductAnalysis {
  id                 String            @id @default(cuid())
  analysisRunId      String
  researchItemId     String
  totalScore         Float
  popularityScore    Float?
  trendScore         Float?
  reviewScore        Float?
  priceScore         Float?
  freshnessScore     Float?
  dataQualityScore   Float
  eligibilityStatus  EligibilityStatus
  exclusionReasons   Json
  scoreBreakdown     Json
  analyzedAt         DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  analysisRun       AnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  researchItem      ResearchItem       @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  contentCandidates ContentCandidate[]

  @@unique([analysisRunId, researchItemId])
  @@index([analysisRunId, totalScore])
  @@index([researchItemId, analyzedAt])
  @@index([eligibilityStatus])
}

model ContentCandidate {
  id                String                 @id @default(cuid())
  analysisRunId     String
  researchItemId    String
  productAnalysisId String
  candidateType     ContentCandidateType
  rank              Int
  selectionScore    Float
  selectionReasons  Json
  targetChannel     ContentTargetChannel   @default(GENERIC)
  status            ContentCandidateStatus @default(SELECTED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  analysisRun       AnalysisRun        @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  researchItem      ResearchItem       @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  productAnalysis   ProductAnalysis    @relation(fields: [productAnalysisId], references: [id], onDelete: Cascade)
  generatedContents GeneratedContent[]
  xPublications     XPublication[]

  @@unique([analysisRunId, candidateType, researchItemId])
  @@index([analysisRunId, candidateType, rank])
  @@index([researchItemId])
  @@index([status])
}

enum ContentGenerationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum GeneratedContentType {
  BLOG_ARTICLE
  X_POST
  SHORT_VIDEO_SCRIPT
  PRODUCT_INTRODUCTION
}

enum GeneratedContentStatus {
  DRAFT
  VALIDATION_FAILED
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  READY_TO_PUBLISH
  PUBLISHED
  ARCHIVED
}

enum ContentValidationIssueType {
  FORBIDDEN_SOURCE_TEXT
  REVIEW_TEXT_DETECTED
  MISSING_AFFILIATE_URL
  INVALID_AFFILIATE_URL
  UNSUPPORTED_CLAIM
  PROHIBITED_IMAGE
  IMAGE_CONFIRMATION_REQUIRED
  DUPLICATE_CONTENT
  EMPTY_CONTENT
  LENGTH_EXCEEDED
  LENGTH_TOO_SHORT
  MISSING_DISCLOSURE
  INVALID_HASHTAG
  RAW_DATA_EXPOSURE
  SENSITIVE_VALUE_EXPOSURE
  FABRICATED_FACT
  STRUCTURE_INVALID
}

enum ContentValidationSeverity {
  INFO
  WARNING
  ERROR
  BLOCKING
}

enum ContentReviewDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

model ContentGenerationRun {
  id             String                     @id @default(cuid())
  status         ContentGenerationRunStatus @default(PENDING)
  providerName   String
  modelName      String
  parameters     Json
  promptVersion  String
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  candidateCount Int                        @default(0)
  generatedCount Int                        @default(0)
  skippedCount   Int                        @default(0)
  errorCount     Int                        @default(0)
  errorMessage   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  contents GeneratedContent[]

  @@index([status, createdAt])
}

model GeneratedContent {
  id                 String                 @id @default(cuid())
  generationRunId    String?
  contentCandidateId String
  researchItemId     String
  /// Link to lifecycle Content (P1/P2 split). Optional for backward compatibility.
  contentId          String?
  contentVersionId   String?
  contentType        GeneratedContentType
  targetChannel      ContentTargetChannel   @default(GENERIC)
  status             GeneratedContentStatus @default(DRAFT)
  title              String
  body               String
  summary            String?
  hashtags           Json
  callToAction       String?
  affiliateUrl       String
  imageId            String?
  promptVersion      String
  generationProvider String
  generationModel    String
  inputSnapshot      Json
  validationResult   Json?
  contentHash        String
  version            Int                    @default(1)
  parentContentId    String?
  generatedAt        DateTime
  approvedAt         DateTime?
  rejectedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  generationRun    ContentGenerationRun?    @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  contentCandidate ContentCandidate         @relation(fields: [contentCandidateId], references: [id], onDelete: Cascade)
  researchItem     ResearchItem             @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  content          Content?                 @relation(fields: [contentId], references: [id], onDelete: SetNull)
  contentVersion   ContentVersion?          @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  parentContent    GeneratedContent?        @relation("ContentVersions", fields: [parentContentId], references: [id], onDelete: SetNull)
  childContents    GeneratedContent[]       @relation("ContentVersions")
  validationIssues ContentValidationIssue[]
  reviews          ContentReview[]
  xPublications    XPublication[]

  @@index([contentCandidateId, contentType, version])
  @@index([researchItemId, contentType])
  @@index([contentId])
  @@index([contentVersionId])
  @@index([status, createdAt])
  @@index([contentHash])
  @@index([generationRunId])
}

model ContentValidationIssue {
  id                 String                     @id @default(cuid())
  generatedContentId String
  issueType          ContentValidationIssueType
  severity           ContentValidationSeverity
  fieldName          String?
  message            String
  detectedValue      String?
  createdAt          DateTime                   @default(now())

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@index([generatedContentId, severity])
}

model ContentReview {
  id                 String                @id @default(cuid())
  generatedContentId String
  decision           ContentReviewDecision
  reviewer           String
  comment            String?
  createdAt          DateTime              @default(now())

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@index([generatedContentId, createdAt])
}

enum XPublicationStrategyType {
  SINGLE_POST
  ROOT_WITH_REPLY
  THREAD
  RELATED_POST_LINK
  HUB_POST
  CONTROL
}

enum XPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PARTIALLY_PUBLISHED
  PUBLISHED
  PUBLISHED_UNVERIFIED
  FAILED
  BLOCKED
  CANCELLED
  DELETED
}

enum XApiCredentialStatus {
  PENDING
  ACTIVE
  REFRESH_REQUIRED
  EXPIRED
  REVOKED
  INVALID
  DISABLED
}

enum XOAuthSessionStatus {
  PENDING
  CONSUMED
  EXPIRED
  FAILED
  CANCELLED
}

enum XApiUsageSource {
  LOCAL_ESTIMATE
  X_USAGE_API
  MANUAL
  DEVELOPER_CONSOLE
}

enum XApiBudgetPeriodType {
  DAILY
  MONTHLY
}

enum XApiBudgetStatus {
  ACTIVE
  SOFT_LIMIT_REACHED
  HARD_LIMIT_REACHED
  PAUSED
}

enum XProductReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
  CANCELLED
}

enum XAuditActorType {
  SYSTEM
  ADMIN
  SCHEDULER
  CLI
}

enum XAuditResult {
  SUCCESS
  REJECTED
  BLOCKED
  FAILED
  SKIPPED
}

enum XPublicationPostRole {
  ROOT
  REPLY
  RELATED_LINK
  CTA
  HUB
}

enum XPublicationPostStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
  CANCELLED
}

enum XExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum XExperimentAllocationMethod {
  ROUND_ROBIN
  RANDOM
  WEIGHTED
  MANUAL
}

enum XStrategyConfidenceLevel {
  INSUFFICIENT
  LOW
  MEDIUM
  HIGH
}

model XPublication {
  id                   String                 @id @default(cuid())
  generatedContentId   String
  contentCandidateId   String
  researchItemId       String
  strategyType         XPublicationStrategyType
  status               XPublicationStatus     @default(DRAFT)
  scheduledAt          DateTime?
  publishingStartedAt  DateTime?
  publishedAt          DateTime?
  failedAt             DateTime?
  rootPostId           String?
  conversationId       String?
  rootPostUrl          String?
  accountId            String?
  attemptCount         Int                    @default(0)
  lastErrorType        String?
  lastErrorMessage     String?
  idempotencyKey       String                 @unique
  experimentGroup      String?
  strategyVersion      String                 @default("x-strategy-v1")
  nextRetryAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)
  contentCandidate ContentCandidate @relation(fields: [contentCandidateId], references: [id], onDelete: Cascade)
  researchItem     ResearchItem     @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  posts            XPublicationPost[]
  metricSnapshots  XPostMetricSnapshot[]
  locks            XPublicationLock[]

  @@index([status, scheduledAt])
  @@index([researchItemId, status])
  @@index([strategyType, status])
  @@index([generatedContentId])
  @@index([nextRetryAt])
}

model XPublicationPost {
  id                   String                 @id @default(cuid())
  publicationId        String
  sequence             Int
  role                 XPublicationPostRole
  status               XPublicationPostStatus @default(PENDING)
  body                 String
  bodyHash             String?
  weightedLength       Int
  replyToSequence      Int?
  relatedPublicationId String?
  xPostId              String?
  xPostUrl             String?
  publishedAt          DateTime?
  failedAt             DateTime?
  attemptCount         Int                    @default(0)
  lastErrorType        String?
  lastErrorMessage     String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  publication      XPublication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  metricSnapshots  XPostMetricSnapshot[]

  @@unique([publicationId, sequence])
  @@index([publicationId, status])
  @@index([xPostId])
  @@index([bodyHash, createdAt])
}

model XPublicationLock {
  id            String   @id @default(cuid())
  publicationId String
  lockKey       String   @unique
  ownerId       String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  publication XPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([publicationId])
}

model XPostMetricSnapshot {
  id                        String   @id @default(cuid())
  publicationId             String
  publicationPostId         String?
  xPostId                   String
  measuredAt                DateTime
  impressionCount           Int?
  likeCount                 Int?
  replyCount                Int?
  repostCount               Int?
  quoteCount                Int?
  bookmarkCount             Int?
  urlClickCount             Int?
  profileClickCount         Int?
  detailExpandCount         Int?
  mediaViewCount            Int?
  followerCountAtMeasurement Int?
  rawMetricAvailability     Json
  source                    String
  collectionWindowMinutes   Int?
  metricsVersion            String   @default("x-metrics-v1")
  createdAt                 DateTime @default(now())

  publication     XPublication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  publicationPost XPublicationPost? @relation(fields: [publicationPostId], references: [id], onDelete: SetNull)

  @@unique([xPostId, measuredAt])
  @@index([publicationId, measuredAt])
  @@index([publicationPostId, measuredAt])
  @@index([collectionWindowMinutes])
}

model XStrategyPerformance {
  id                          String                   @id @default(cuid())
  strategyType                XPublicationStrategyType
  strategyVersion             String
  evaluationWindowHours       Int
  sampleCount                 Int
  eligibleSampleCount         Int
  averageImpressions          Float?
  medianImpressions           Float?
  averageEngagementRate       Float?
  medianEngagementRate        Float?
  averageUrlClickRate         Float?
  averageProfileClickRate     Float?
  averageReplyContinuationRate Float?
  confidenceLevel             XStrategyConfidenceLevel
  score                       Float?
  recommendedStrategy         XPublicationStrategyType?
  supportingMetrics           Json?
  dataLimitations             Json?
  calculatedAt                DateTime
  parameters                  Json
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@index([strategyType, strategyVersion, calculatedAt])
  @@index([calculatedAt])
}

model XPublicationExperiment {
