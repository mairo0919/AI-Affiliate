  releaseMode    String?
  result         XAuditResult
  reason         String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([action, createdAt])
  @@index([publicationId, createdAt])
  @@index([productKeyHash, createdAt])
  @@index([result, createdAt])
}

model XApiCredential {
