  MONETIZED
  NOT_APPLICABLE
}

model AffiliateProviderRegistry {
  id           String   @id @default(cuid())
  providerKey  String   @unique
  displayName  String
  capabilities Json
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products AffiliateProduct[]
}

model AffiliateProduct {
  id                 String   @id @default(cuid())
  providerKey        String
  externalProductId  String
  title              String
  url                String?
  affiliateUrl       String?
  locale             String   @default("ja-JP")
  currency           String?
  adultFlag          Boolean  @default(true)
  availability       String   @default("UNKNOWN")
  normalized         Json
  metadata           Json?
  collectedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider AffiliateProviderRegistry @relation(fields: [providerKey], references: [providerKey])
  topicCandidates TopicCandidate[]
  snapshots ProductSnapshot[]
  productLinks ProductLink[]

  @@unique([providerKey, externalProductId])
  @@index([providerKey, collectedAt])
}

/// Catalog-level link candidate (not a usage site). Usage is tracked via ProductLinkUsage.
/// Selection priority: preferred affiliate → preferred product → future ASP affiliate →
/// future ASP product → official → trusted → none.
enum ProductLinkType {
  PROVIDER_PRODUCT
  AFFILIATE
  OFFICIAL
  TRUSTED_PRODUCT
  OTHER
}

enum AffiliateReplacementStatus {
  NOT_APPLICABLE
  AWAITING_PROVIDER
  AWAITING_MATCH
  CANDIDATE_FOUND
  AWAITING_APPROVAL
  APPROVED
  REPLACED
  REJECTED
  INVALID
}

enum ProductLinkUsageKind {
  CTA
  BODY
  METADATA
}

enum LinkReplacementEventStatus {
  PROPOSED
  AWAITING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
}

model ProductLink {
  id                            String                     @id @default(cuid())
  affiliateProductId            String?
  /// Logical product identity shared across providers (same-product matching).
  productMatchKey               String?
  url                           String?
  preferredAffiliateProvider    String
  currentLinkProvider           String
  currentLinkType               ProductLinkType
  replacePriority               Int
  availability                  String                     @default("AVAILABLE")
  isSelected                    Boolean                    @default(false)
  replacementStatus             AffiliateReplacementStatus @default(NOT_APPLICABLE)
  candidateAffiliateUrl         String?
  candidateAffiliateProductId   String?
  matchedProvider               String?
  matchConfidence               Float?
  matchReason                   String?
  detectedAt                    DateTime?
  approvedAt                    DateTime?
  approvedBy                    String?
  replacedAt                    DateTime?
  rejectionReason               String?
  metadata                      Json?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  product            AffiliateProduct?      @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)
  usages             ProductLinkUsage[]
  replacementEvents  LinkReplacementEvent[]

  @@index([affiliateProductId, replacePriority])
  @@index([productMatchKey])
  @@index([preferredAffiliateProvider, currentLinkType])
  @@index([replacementStatus])
}

/// Where a ProductLink was actually used (one catalog link → many articles/targets).
model ProductLinkUsage {
  id                   String              @id @default(cuid())
  productLinkId        String
  contentVersionId     String?
  publicationTargetId  String?
  publicationRecordId  String?
  usageKind            ProductLinkUsageKind
  /// e.g. "cta", "body:href:0", "body:paragraph:3"
  locationHint         String?
  urlSnapshot          String?
  createdAt            DateTime            @default(now())

  productLink        ProductLink         @relation(fields: [productLinkId], references: [id], onDelete: Cascade)
  contentVersion     ContentVersion?     @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  publicationTarget  PublicationTarget?  @relation(fields: [publicationTargetId], references: [id], onDelete: Cascade)
  publicationRecord  PublicationRecord?  @relation(fields: [publicationRecordId], references: [id], onDelete: Cascade)

  @@index([productLinkId, createdAt])
  @@index([contentVersionId])
  @@index([publicationTargetId])
  @@index([publicationRecordId])
}

/// Non-destructive affiliate URL replacement history for published content.
model LinkReplacementEvent {
  id                         String                     @id @default(cuid())
  productLinkId              String?
  contentId                  String
  sourceContentVersionId     String
  targetContentVersionId     String?
  sourcePublicationTargetId  String?
  targetPublicationTargetId  String?
  publicationRecordId        String?
  previousUrl                String
  nextUrl                    String
  changeReason               String
  approvedBy                 String?
  approvedAt                 DateTime?
  replacedAt                 DateTime?
  status                     LinkReplacementEventStatus @default(PROPOSED)
  metadata                   Json?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  productLink             ProductLink?        @relation(fields: [productLinkId], references: [id], onDelete: SetNull)
  content                 Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sourceContentVersion    ContentVersion      @relation("ReplacementSourceVersion", fields: [sourceContentVersionId], references: [id], onDelete: Cascade)
  targetContentVersion    ContentVersion?     @relation("ReplacementTargetVersion", fields: [targetContentVersionId], references: [id], onDelete: SetNull)
  sourcePublicationTarget PublicationTarget?  @relation("ReplacementSourceTarget", fields: [sourcePublicationTargetId], references: [id], onDelete: SetNull)
  targetPublicationTarget PublicationTarget?  @relation("ReplacementTargetTarget", fields: [targetPublicationTargetId], references: [id], onDelete: SetNull)
  publicationRecord       PublicationRecord?  @relation(fields: [publicationRecordId], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
  @@index([productLinkId, status])
  @@index([status, createdAt])
}

model ProductSnapshot {
  id                String   @id @default(cuid())
  affiliateProductId String
  capturedAt        DateTime @default(now())
  payload           Json
  createdAt         DateTime @default(now())

  product AffiliateProduct @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)

  @@index([affiliateProductId, capturedAt])
}

model SourceDocument {
  id              String   @id @default(cuid())
  sourceKey       String
  externalId      String?
  url             String?
  title           String?
  documentType    String
  contentHash     String?
  retrievedAt     DateTime @default(now())
  publishedAt     DateTime?
  freshnessScore  Float?
  robotsAllowed   Boolean?
  termsNotes      String?
  rateLimitNotes  String?
  normalizedText  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  findings ResearchFinding[]
  claimSources ClaimSource[]
  articleStructureObservations ArticleStructureObservation[]

  @@index([sourceKey, retrievedAt])
  @@index([contentHash])
}

model ResearchFinding {
  id               String   @id @default(cuid())
  sourceDocumentId String?
  findingType      String
  summary          String
  confidence       Float?
  noveltyScore     Float?
  metadata         Json?
  observedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  claims         Claim[]

  @@index([findingType, observedAt])
}

model TopicCandidate {
  id                 String   @id @default(cuid())
  title              String
  summary            String?
  formatHint         String?
  formatCategory     ContentFormatCategory @default(OTHER)
  status             String   @default("PROPOSED")
  selectionReasons   Json?
  affiliateProductId String?
  contentCandidateId String?
  researchItemId     String?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  affiliateProduct AffiliateProduct? @relation(fields: [affiliateProductId], references: [id], onDelete: SetNull)
  strategies       ContentStrategy[]
  contents         Content[]

  @@index([status, createdAt])
  @@index([affiliateProductId])
}

model ContentStrategy {
  id                  String         @id @default(cuid())
  topicCandidateId    String
  objective           String
  targetAudience      String
  userIntent          String
  formatCategory      ContentFormatCategory
  formatKey           String
  angle               String
  primaryChannel      PublicationPlatform
  candidateChannels   Json
  affiliateIntent     String?
  ctaPolicy           String?
  timingRationale     String?
  differentiation     String?
  requiredClaims      Json
  requiredResearch    Json
  successMetrics      Json
  riskFlags           Json
  status              StrategyStatus @default(DRAFT)
  confidence          Float?
  evidenceRefs        Json?
  modelRunId          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  topicCandidate TopicCandidate @relation(fields: [topicCandidateId], references: [id], onDelete: Cascade)
  contents       Content[]
  claims         Claim[]

  @@index([topicCandidateId, status])
  @@index([primaryChannel, status])
}

model Content {
  id               String                 @id @default(cuid())
  topicCandidateId String?
  strategyId       String?
  status           ContentLifecycleStatus @default(DRAFT)
  primaryLanguage  String                 @default("ja")
  contentPurpose   String?
  monetizationStatus MonetizationStatus   @default(UNMONETIZED)
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  topicCandidate   TopicCandidate?  @relation(fields: [topicCandidateId], references: [id], onDelete: SetNull)
  strategy         ContentStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  versions         ContentVersion[]
  publicationTargets PublicationTarget[]
  legacyGenerated  GeneratedContent[]
  linkReplacementEvents LinkReplacementEvent[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([status, createdAt])
  @@index([strategyId])
  @@index([monetizationStatus, createdAt])
}

/// Manual / imported / future-API metrics (P3/P4). Not X-specific.
model AnalyticsSnapshot {
  id                   String   @id @default(cuid())
  platform             String
  contentId            String?
  publicationTargetId  String?
  publicationRecordId  String?
  externalId           String?
  measuredAt           DateTime @default(now())
  metrics              Json
  source               String   @default("manual")
  notes                String?
  metadata             Json?
  createdAt            DateTime @default(now())

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([platform, measuredAt])
  @@index([contentId, measuredAt])
  @@index([source, measuredAt])
}

model ContentVersion {
  id               String               @id @default(cuid())
  contentId        String
  versionNumber    Int
  parentVersionId  String?
  revisionType     String               @default("initial")
  title            String
  summary          String?
  body             String
  structuredContent Json?
  status           ContentVersionStatus @default(DRAFT)
  createdBy        String               @default("system")
  modelRunId       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  content          Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  productLinkUsages ProductLinkUsage[]
  replacementEventsAsSource LinkReplacementEvent[] @relation("ReplacementSourceVersion")
  replacementEventsAsTarget LinkReplacementEvent[] @relation("ReplacementTargetVersion")
  parentVersion    ContentVersion?      @relation("VersionTree", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions    ContentVersion[]     @relation("VersionTree")
  versionClaims    ContentVersionClaim[]
  publicationTargets PublicationTarget[]
  legacyGenerated  GeneratedContent[]
  reviews          QualityReviewRecord[]

  @@unique([contentId, versionNumber])
  @@index([status, createdAt])
}

model Claim {
  id               String      @id @default(cuid())
  statement        String
  claimType        ClaimType   @default(UNVERIFIED)
  status           ClaimStatus @default(PROPOSED)
  confidence       Float?
  freshnessScore   Float?
  classification   String      @default("third_party")
  firstObservedAt  DateTime    @default(now())
  lastVerifiedAt   DateTime?
  expiresAt        DateTime?
  strategyId       String?
  researchFindingId String?
  metadata         Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  strategy         ContentStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  researchFinding  ResearchFinding? @relation(fields: [researchFindingId], references: [id], onDelete: SetNull)
  sources          ClaimSource[]
  versionClaims    ContentVersionClaim[]

  @@index([status, claimType])
  @@index([strategyId])
}

model ClaimSource {
  id               String   @id @default(cuid())
  claimId          String
  sourceDocumentId String?
  supportType      String
  excerptOrSummary String
  sourceLocation   String?
  retrievedAt      DateTime @default(now())
  confidence       Float?
  contradiction    Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())

  claim          Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([claimId])
