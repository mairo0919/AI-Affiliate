  id                      String   @id @default(cuid())
  /// BLOG | X (extension: future channel ids without Core rewrite)
  channel                 String
  status                  String   @default("RUNNING")
  /// SHADOW | ACTIVE — Foundation uses SHADOW (no production reject/publish authority)
  mode                    String   @default("SHADOW")
  topicId                 String?
  strategyId              String?
  contentId               String?
  contentVersionId        String?
  formatKey               String?
  contentType             String?
  structurePatternId      String?
  editorialPatternId      String?
  claimProfile            String?
  selectedClaimIds        Json?
  retrievedExperienceIds  Json?
  corePlan                Json?
  channelPlan             Json?
  generatorModelRunIds    Json?
  validatorResults        Json?
  reviewResult            Json?
  repairAttempts          Json?
  /// PASS | TARGETED_REPAIR | REPLAN | FULL_REGEN | ESCALATE | SKIPPED
  brainDecision           String?
  /// Existing system decision for comparison (e.g. GENERATED_OK | VALIDATION_FAILED)
  legacyDecision          String?
  finalDecision           String?
  failureCodes            Json?
  publishRef              String?
  performanceRef          String?
  errorDetail             String?
  metadata                Json?
  startedAt               DateTime @default(now())
  completedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  experiences EditorialExperience[]

  @@index([channel, createdAt])
  @@index([mode, status, createdAt])
  @@index([contentVersionId])
  @@index([strategyId, createdAt])
  @@index([formatKey, channel, createdAt])
  @@index([claimProfile, createdAt])
}

