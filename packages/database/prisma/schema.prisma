  URL_PLACEMENT
  DISCLOSURE_PLACEMENT
  CTA_STYLE
  RELATED_POST_USAGE
  INFORMATION_DENSITY
  TITLE_LENGTH
}

enum XOptimizationFindingType {
  POSITIVE
  NEGATIVE
  NEUTRAL
  INSUFFICIENT_DATA
  CONFLICTING
}

enum XOptimizationRecommendationStatus {
  PROPOSED
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
  APPLIED
  CANCELLED
}

enum XOptimizationPriority {
  LOW
  MEDIUM
  HIGH
}

enum XOptimizationApplicationStatus {
  PREPARED
  APPLIED
  EVALUATING
  COMPLETED
  CANCELLED
  FAILED
}

model XOptimizationRun {
  id                          String                  @id @default(cuid())
  status                      XOptimizationRunStatus  @default(PENDING)
  optimizationVersion         String                  @default("x-optimization-v1")
  metricVersion               String                  @default("x-optimization-metrics-v1")
  evaluationWindowHours       Int
  parameters                  Json
  startedAt                   DateTime?
  completedAt                 DateTime?
  failedAt                    DateTime?
  analyzedPublicationCount    Int                     @default(0)
  generatedRecommendationCount Int                    @default(0)
  approvedRecommendationCount Int                     @default(0)
  rejectedRecommendationCount Int                     @default(0)
  errorCount                  Int                     @default(0)
  errorMessage                String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  findings         XOptimizationFinding[]
  recommendations  XOptimizationRecommendation[]

  @@index([status, createdAt])
}

model XOptimizationFinding {
  id                   String                    @id @default(cuid())
  optimizationRunId    String
  dimension            XOptimizationDimension
  segmentKey           String
  currentVariant       String
  comparedVariant      String
  currentSampleCount   Int
  comparedSampleCount  Int
  currentScore         Float?
  comparedScore        Float?
  scoreDifference      Float?
  confidenceLevel      XStrategyConfidenceLevel
  statisticalResult    Json?
  supportingMetrics    Json?
  dataLimitations      Json?
  findingType          XOptimizationFindingType
  createdAt            DateTime                  @default(now())

  optimizationRun XOptimizationRun              @relation(fields: [optimizationRunId], references: [id], onDelete: Cascade)
  recommendations XOptimizationRecommendation[]

  @@index([optimizationRunId, dimension])
  @@index([dimension, findingType])
}

model XOptimizationRecommendation {
  id                 String                            @id @default(cuid())
  optimizationRunId  String
  findingId          String?
  dimension          XOptimizationDimension
  status             XOptimizationRecommendationStatus @default(REVIEW_REQUIRED)
  priority           XOptimizationPriority             @default(MEDIUM)
  currentValue       String
  recommendedValue   String
  rationale          String
  expectedImpact     Json?
  confidenceLevel    XStrategyConfidenceLevel
  requiredSampleSize Int                               @default(30)
  expiresAt          DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  reviewer           String?
  reviewComment      String?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  optimizationRun XOptimizationRun            @relation(fields: [optimizationRunId], references: [id], onDelete: Cascade)
  finding         XOptimizationFinding?       @relation(fields: [findingId], references: [id], onDelete: SetNull)
  applications    XOptimizationApplication[]

  @@index([status, dimension])
  @@index([optimizationRunId])
  @@index([expiresAt])
}

model XOptimizationApplication {
  id                  String                         @id @default(cuid())
  recommendationId    String
  sourcePublicationId String?
  generatedContentId  String?
  targetPublicationId String?
  experimentId        String?
  appliedValue        String
  status              XOptimizationApplicationStatus @default(PREPARED)
  appliedAt           DateTime?
  completedAt         DateTime?
  result              Json?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  recommendation XOptimizationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId, status])
  @@index([generatedContentId])
}

model XContentVariant {
